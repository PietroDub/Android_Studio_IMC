<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/espacamento_pagina">

        <TextView
            android:id="@+id/textoMensagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/titulo_calculadora"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacamento_pequeno"
            android:gravity="center"
            android:text="@string/descricao_calculadora"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacamento_grande"
            android:hint="@string/dica_peso"
            app:boxBackgroundMode="outline"
            app:suffixText="@string/unidade_quilograma">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoPeso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacamento_medio"
            android:hint="@string/dica_altura"
            app:boxBackgroundMode="outline"
            app:suffixText="@string/unidade_metro">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoAltura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoCalcular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacamento_grande"
            android:minHeight="@dimen/altura_minima_toque"
            android:text="@string/botao_calcular" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacamento_grande"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="@dimen/raio_cartao"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/textoResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:importantForAccessibility="yes"
                android:padding="@dimen/espacamento_grande"
                android:text="@string/resultado_aguardando"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
